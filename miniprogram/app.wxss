page {
  background: #fff9f0;
  color: #333333;
  font-size: 28rpx;
}

.container {
  padding: 32rpx;
}

.primary-button {
  background: #f59a23;
  color: #ffffff;
  border-radius: 48rpx;
  margin: 24rpx 0;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 80, 20, 0.06);
}

.muted { color: #888888; }
.title { font-size: 36rpx; font-weight: 700; }
