<view class="container"><view class="filters"><text>距离</text><text>价格</text><text>评分</text><text>时间</text></view><view wx:for="{{walkers}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail" class="card walker"><view class="avatar">🐕</view><view class="walker-main"><view class="walker-name">{{item.name}}</view><view class="muted">⭐ {{item.rating}} · {{item.distance}}</view><view class="muted">擅长：{{item.tags}}</view></view><view class="price">¥{{item.price}}</view></view></view>
