<view class="container"><view class="card"><view class="label">选择宠物</view><view class="select">🐕 {{petName}} <text>›</text></view></view><view class="card"><view class="label">服务日期</view><picker mode="date"><view class="select">{{date}} <text>›</text></view></picker><view class="label">开始时间</view><picker mode="time"><view class="select">{{time}} <text>›</text></view></picker><view class="label">服务时长</view><view class="select" bindtap="chooseDuration">{{duration}}分钟 <text>›</text></view><view class="label">服务地点</view><input placeholder="请输入小区或详细地址" bindinput="onAddressInput" /></view><view class="card"><view class="label">特殊要求</view><textarea placeholder="例如：请单独遛狗，注意不要接触其他犬只"></textarea></view><button class="primary-button" bindtap="submit">确认需求并支付（模拟）</button></view>
