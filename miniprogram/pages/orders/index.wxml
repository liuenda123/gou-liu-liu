<view class="container"><view wx:if="{{orders.length}}"><view wx:for="{{orders}}" wx:key="id" class="card" bindtap="viewOrder"><view class="order-head"><text>订单 {{item.id}}</text><text class="status">{{item.status}}</text></view><view class="muted">普通遛狗 · {{item.duration}}</view><view>{{item.date}}</view><view class="amount">¥{{item.amount}}</view></view></view><view wx:else class="empty">还没有订单</view></view>
